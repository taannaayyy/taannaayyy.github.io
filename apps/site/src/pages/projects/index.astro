---
import Layout from "@sage/layouts/Layout.astro";
import Header from "@sage/components/Header.astro";
import Main from "@sage/components/Main.astro";
import Footer from "@sage/components/Footer.astro";
import config from "@sage/config";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjects } from "../../utils/projects";

const projects = await getProjects();
const tags = [...new Set(projects.flatMap(p => p.data.tags))].sort();
---

<Layout
  title={`Projects | ${config.site.title}`}
  description="Things I've built, with demos and code."
>
  <Header />

  <Main pageTitle="Projects" pageDesc="Things I've built, with demos and code.">
    {projects.length === 0 ? (
      <p class="empty">Projects are on their way. Check back soon.</p>
    ) : (
      <>
        {tags.length > 1 && (
          <div class="filters" role="group" aria-label="Filter by tag">
            <button type="button" data-filter="" aria-pressed="true">
              All
            </button>
            {tags.map(tag => (
              <button type="button" data-filter={tag} aria-pressed="false">
                {tag}
              </button>
            ))}
          </div>
        )}
        <ul id="project-list">
          {projects.map(project => (
            <ProjectCard project={project} />
          ))}
        </ul>
      </>
    )}
  </Main>

  <Footer />
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("#project-list > li");
  for (const button of buttons) {
    button.addEventListener("click", () => {
      const tag = button.dataset.filter ?? "";
      for (const b of buttons)
        b.setAttribute("aria-pressed", String(b === button));
      for (const card of cards) {
        const tags = (card.dataset.tags ?? "").split(" ");
        card.hidden = tag !== "" && !tags.includes(tag);
      }
    });
  }
</script>

<style>
  .empty {
    color: var(--fg-muted);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .filters button {
    padding: 0.15rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-raised);
    color: var(--fg-muted);
    font-family: var(--font-ui);
    font-size: 0.875rem;
    cursor: pointer;
    transition:
      color 120ms,
      border-color 120ms;
  }
  .filters button:hover,
  .filters button[aria-pressed="true"] {
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 50%, var(--border));
  }
</style>
