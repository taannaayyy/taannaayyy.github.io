---
import type { CollectionEntry } from "astro:content";
import { projectUrl } from "../utils/projects";

type Props = {
  project: CollectionEntry<"projects">;
  variant?: "h2" | "h3";
};

const { project, variant: Heading = "h2" } = Astro.props;
const { title, summary, stack, tags } = project.data;
---

<li class="project-card" data-tags={tags.join(" ")}>
  <a href={projectUrl(project)} class="group block">
    <Heading class="card-title group-hover:text-accent">{title}</Heading>
    <p class="card-desc">{summary}</p>
  </a>
  {stack.length > 0 && (
    <ul class="card-stack" aria-label="Stack">
      {stack.map(item => (
        <li>{item}</li>
      ))}
    </ul>
  )}
</li>

<style>
  .project-card {
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--border);
  }
  .project-card:last-child {
    border-bottom: 0;
  }
  .card-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    line-height: 1.25;
    font-weight: 600;
    text-wrap: balance;
    transition: color 120ms;
  }
  .card-desc {
    margin-top: 0.4rem;
    color: var(--fg-muted);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .card-stack {
    margin-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--sage);
  }
</style>
