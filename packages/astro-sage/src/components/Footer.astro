---
import type { HTMLAttributes } from "astro/types";
import SocialList from "./SocialList.astro";
import config from "@sage/config";

type Props = {
  noMarginTop?: boolean;
  /** Hide the social links, e.g. on a page that already lists them. */
  hideSocials?: boolean;
} & HTMLAttributes<"footer">;

const {
  noMarginTop = false,
  hideSocials = false,
  class: className,
  ...attrs
} = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border text-muted-foreground flex flex-col-reverse items-center justify-between gap-6 border-t py-8 text-sm sm:flex-row">
    <p>
      © {currentYear} {config.site.author}
    </p>
    {!hideSocials && <SocialList />}
  </div>
</footer>
